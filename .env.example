# Valores fictícios. Copie para .env (ignorado pelo Git) e gere dois segredos distintos.
# Nunca use prefixo VITE_ para segredos. Não ative IA antes de aprovar modelo e orçamento.
API_SHARED_SECRET=SUBSTITUA_POR_SEGREDO_ALEATORIO_1_COM_32_CARACTERES_OU_MAIS
CLIENT_HASH_SECRET=SUBSTITUA_POR_SEGREDO_ALEATORIO_2_COM_32_CARACTERES_OU_MAIS
PUBLIC_ORIGIN=http://127.0.0.1:5173
HOST=127.0.0.1
PORT=8788
DATABASE_PATH=data/usage.sqlite
API_DEV_PROXY=false
# Publicação sem assistente. true é reservado à validação local da integração futura.
VITE_ASSISTANT_ENABLED=false
AI_ENABLED=false
OPENAI_API_KEY=
AI_MODEL=
# Preços em USD por milhão de tokens, revalidados para o modelo escolhido.
INPUT_USD_PER_MILLION=0
OUTPUT_USD_PER_MILLION=0
# 1 USD = 1.000.000 micro-USD. Zero desliga chamadas. Nenhum gasto aprovado por este exemplo.
DAILY_BUDGET_MICRO_USD=0
MONTHLY_BUDGET_MICRO_USD=0
REQUESTS_PER_DAY=100
REQUESTS_PER_CLIENT_WINDOW=5
MAX_CONCURRENT=2
# Avaliação local: não habilitar sem autorização de gasto. Teto separado da API.
EVAL_ALLOW_REAL=false
EVAL_MAX_MICRO_USD=0
