{
  "name": "clareza-digital",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/license-notices.mjs && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "cf:dev": "wrangler dev",
    "cf:check": "npm run build && tsc -p apps/worker/tsconfig.json && wrangler deploy --dry-run --env production",
    "api:build": "vite build --config apps/api/vite.config.ts",
    "api:start": "node --env-file=.env apps/api/dist/server.js",
    "cf:types": "wrangler types apps/worker/env.d.ts --strict-vars=false",
    "test:worker": "playwright test --config playwright.worker.config.ts --workers=1",
    "test:ops": "node --test tests/backup.test.mjs",
    "ai:eval:build": "vite build --config apps/api/vite.config.ts --ssr apps/api/src/evaluate.ts --outDir apps/api/evaluation",
    "ai:eval": "node apps/api/evaluation/evaluate.js",
    "license:notices": "node scripts/license-notices.mjs"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/workers-types": "^5.20261114.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.162.0"
  },
  "license": "MIT"
}
