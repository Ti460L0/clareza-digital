{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "noEmit": true,
    "types": [
      "vite/client",
      "node"
    ]
  },
  "exclude": ["tests/worker.test.ts"],
  "include": [
    "apps/web",
    "packages/content",
    "tests",
    "vite.config.ts",
    "playwright.config.ts",
    "apps/api"
  ]
}
