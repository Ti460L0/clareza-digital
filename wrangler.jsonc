{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "clareza-digital-local",
  "main": "apps/worker/index.ts",
  "compatibility_date": "2026-11-14",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  },
  "vars": {
    "PUBLIC_ORIGIN": "http://127.0.0.1:8787",
    "BACKEND_ORIGIN": ""
  },
  "secrets": { "required": [] },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "logs": { "enabled": true, "invocation_logs": false },
    "traces": { "enabled": false }
  },
  "env": {
    "production": {
      "name": "clareza-digital",
      "vars": {
        "PUBLIC_ORIGIN": "https://clarezadigital.cod4ti.com",
        "BACKEND_ORIGIN": ""
      },
      "secrets": { "required": [] },
      "routes": [{ "pattern": "clarezadigital.cod4ti.com", "custom_domain": true }]
    }
  }
}
